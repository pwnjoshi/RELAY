{
  "extends": "next/core-web-vitals",
  "rules": {
    "prefer-const": "warn",
    "no-unused-vars": "off",
    "@next/next/no-html-link-for-pages": "off",
    "no-console": "error"
  },
  "ignorePatterns": [
    ".next/",
    "node_modules/",
    "scripts/",
    "public/",
    "*.config.js"
  ]
}
