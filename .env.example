# ==============================================================================
# RELAY Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit real credentials to source control.
# ==============================================================================

# CALL-E Telephony REST API Credentials (Required for Live Calls)
CALLE_API_KEY=your-calle-api-key-here
CALLE_SOURCE=skills_sh
CALLE_INTEGRATION=skills_sh_skill
CALLE_INTEGRATION_VERSION=0.1.0

# Nebius AI Token Factory (Required for DeepSeek-V4 Post-Call Intelligence & Web RAG)
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# JWT Secret Keys (Required for Enterprise Session Authentication)
JWT_SECRET=your-jwt-secret-at-least-32-chars-long-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars-long-here

# Google Calendar OAuth 2.0 Credentials (Required for Real Two-Way Calendar Booking)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Slack & Webhook Connector Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Supabase Production Database Persistence (Optional Cloud Sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Node Environment & Port
NODE_ENV=development
PORT=3000
